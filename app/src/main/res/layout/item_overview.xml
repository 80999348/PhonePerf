<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="8dp">

    <!-- 设备标题 -->
    <TextView
        android:id="@+id/deviceName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold"
        tools:text="Xiaomi 14" />

    <TextView
        android:id="@+id/deviceSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        tools:text="Android 14 · 3 个频率簇 · 8 核" />

    <!-- 三个仪表 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        app:cardBackgroundColor="@color/card"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.example.phoneperf.ui.GaugeView
                    android:id="@+id/cpuGauge"
                    android:layout_width="0dp"
                    android:layout_height="108dp"
                    android:layout_weight="1" />

                <com.example.phoneperf.ui.GaugeView
                    android:id="@+id/memGauge"
                    android:layout_width="0dp"
                    android:layout_height="108dp"
                    android:layout_weight="1" />

                <com.example.phoneperf.ui.GaugeView
                    android:id="@+id/tempGauge"
                    android:layout_width="0dp"
                    android:layout_height="108dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <com.example.phoneperf.ui.LineChartView
                android:id="@+id/chart"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/updateTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="end"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp"
                tools:text="更新于 21:20:31" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
